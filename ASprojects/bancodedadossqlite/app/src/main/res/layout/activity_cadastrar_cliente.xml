<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@android:color/system_accent1_200"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.CadastrarCliente">

    <TextView android:id="@+id/titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="50dp"
        android:text="Cadastro de Cliente"
        android:textSize="30sp"
        android:textStyle="bold"/>

    <View android:id="@+id/fundo"
        android:layout_width="match_parent"
        android:layout_height="450dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titulo"
        android:background="@android:color/system_accent1_700"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="50dp"/>

    <EditText android:id="@+id/nome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="50dp"
        android:padding="15dp"

        android:hint="Digite o nome"
        app:layout_constraintTop_toTopOf="@id/fundo"
        app:layout_constraintStart_toStartOf="@id/fundo"
        app:layout_constraintEnd_toEndOf="@id/fundo"/>

    <EditText android:id="@+id/Email"
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:hint="Informe o Email"
        android:padding="15dp"
        app:layout_constraintTop_toBottomOf="@+id/nome"
        app:layout_constraintStart_toStartOf="@+id/fundo"
        app:layout_constraintEnd_toEndOf="@+id/fundo"/>


    <EditText android:id="@+id/Telefone"

        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="152dp"
        android:layout_marginEnd="20dp"

        android:hint="Informe o telefone"
        android:padding="15dp"
        app:layout_constraintEnd_toEndOf="@+id/fundo"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/fundo"
        app:layout_constraintTop_toBottomOf="@+id/nome" />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:text="Cadastrar"
        android:textSize="22dp"
        tools:layout_editor_absoluteX="132dp"
        tools:layout_editor_absoluteY="612dp" />




</androidx.constraintlayout.widget.ConstraintLayout>